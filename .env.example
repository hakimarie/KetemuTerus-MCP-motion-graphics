# Required: Google AI Studio API key
GEMINI_API_KEY=

# Required: Supabase project URL and service-role key (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required: long random bearer token for Claude's MCP connection
MCP_AUTH_TOKEN=

# Optional: override model (default gemini-omni-1.2-flash)
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash