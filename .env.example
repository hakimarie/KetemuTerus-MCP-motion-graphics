# MCP shared bearer token. Use a long random value; never commit the real token.
MCP_ACCESS_TOKEN=

# Google Cloud project with Vertex AI API enabled and billing configured.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VEO_MODEL=veo-3.1-generate-001

# JSON service-account key as a single-line JSON string.
# Grant the service account Vertex AI User and permission to write to the output bucket.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Existing GCS bucket URI, e.g. gs://ketemuterus-motion-output/jobs
GCS_OUTPUT_URI=
